# ローカル開発とdocker-compose用の環境変数例
# UID/GID/USERNAME/GROUPNAMEはdevcontainer Dockerfileでコンテナ内に
# 対応するユーザーを作成するために使用されます。デフォルトはUID=1000と"node"です。

# ユーザー/グループ設定
UID=1000
GID=1000
USERNAME=node
GROUPNAME=node

# その他のランタイム環境変数
NODE_ENV=development

# cdktf用変数: 開発環境=dev、本番環境=prod
ENVIRONMENT=prod

# AWSリージョン（未設定時はコードのデフォルト値を使用）
AWS_REGION=ap-northeast-1

# AWS認証情報
# Case 1: アクセスキーを直接指定
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Case 2: AWSプロファイルを使用
# AWS_PROFILE=my-profile-name
